<mvc:View xmlns:uxap="sap.uxap" xmlns:f="sap.f" xmlns:layout="sap.ui.layout" xmlns:filterbar="sap.ui.comp.filterbar"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="bd.businessportal.controller.Categories"
>
    <f:DynamicPage id="category_page" showFooter="false" >
        <f:title>
            <f:DynamicPageTitle >
                <f:heading>
                     <Toolbar style="Clear">
                         <Button icon="sap-icon://nav-back" accessibleRole="Link" ariaDescribedBy="back button" press=".navButtonPressed"/>
                         <Title class="sapUiNoMarginBegin" text="{nav>/pageTitles/category}" wrapping="false" titleStyle="H3" />
                        </Toolbar>
                </f:heading>

                <f:snappedHeading>
                    <Toolbar style="Clear">
                        <Button icon="sap-icon://nav-back" accessibleRole="Link" ariaDescribedBy="back button" press=".navButtonPressed"/>
                        <Title class="sapUiNoMarginBegin" text="{nav>/pageTitles/category}" wrapping="false" titleStyle="H3" />
                    </Toolbar>
                        </f:snappedHeading>
                        <f:actions>
                            <Toolbar style="Clear" ariaHasPopup="Dialog">
                                <Button id="btn_del_category" icon="sap-icon://delete"  press=".del_category"></Button>
                                <Button id="btn_add_category" icon="sap-icon://add" iconFirst="true" type="Default" press=".add_category" > </Button>
                                <Button id="btn_edit_category" icon="sap-icon://edit" iconFirst="true" type="Default" press=".edit_category" > </Button>
                            </Toolbar>
                        </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
             <Panel expandable="false" stickyHeader="false" width="auto">

            <List mode="None" includeItemInSelection="false"  id="table_category" rememberSelections="true" busy="true"
                itemPress=".overViewPage" items="{
                    path:'MD>/Categories',
                    suspended: false,
                    parameters: {
                                $$groupId: 'G1'
                            },
                    sorter:[{path:'CategoryName'}]
                }">
                <ObjectListItem
                    fieldGroupIds="group_category"
                    title="{MD>CategoryName}"
                    type="Navigation"
                    number=""
                    numberUnit="Products">
                    <ObjectAttribute text="Category ID : {MD>ID}" active="false" reactiveAreaMode="Overlay"/>
                    <ObjectAttribute text="{path:'MD>Description',type:'sap.ui.model.type.String'}" active="false" />
                </ObjectListItem>

            </List>
        </Panel>
        </f:content>
        <f:footer>
            <OverflowToolbar  class="sapUiLargeMarginBeginEnd" asyncMode="true"  active="false" design="Transparent">
            <ToolbarSpacer ></ToolbarSpacer>

                <Button  text="select all" id="selectall_category" type="Transparent"  press="._footerCombinedButtons"></Button>
                <Button text="delete" type="Reject" id="deleteItems_category" enabled="false"  press="._footerCombinedButtons"></Button>
                <Button id="cancel_category" class="sapUiSmallMarginEnd" text="cancel" type="Emphasized" press="._footerCombinedButtons"></Button>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>