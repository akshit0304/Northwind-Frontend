<mvc:View xmlns:f="sap.f" xmlns:layout="sap.ui.layout" xmlns:filterbar="sap.ui.comp.filterbar"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="bd.businessportal.controller.Categories"
>
    <f:DynamicPage id="category_page" >
        <f:title>
            <f:DynamicPageTitle >
                <f:heading>
                     <Toolbar style="Clear">
                         <Button icon="sap-icon://nav-back" accessibleRole="Link" ariaDescribedBy="back button" press=".navButtonPressed"/>
                         <Title class="sapUiNoMarginBegin" text="{nav>/pageTitles/category}" wrapping="false" titleStyle="H3" />
                        </Toolbar>
                </f:heading>

                <f:snappedHeading>
                    <Toolbar style="Clear">
                        <Button icon="sap-icon://nav-back" accessibleRole="Link" ariaDescribedBy="back button" press=".navButtonPressed"/>
                        <Title class="sapUiNoMarginBegin" text="{nav>/pageTitles/category}" wrapping="false" titleStyle="H3" />
                    </Toolbar>
                        </f:snappedHeading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
             <Panel expandable="false" stickyHeader="false" width="auto">

            <List mode="None" id="table_category"
                itemPress="overViewPage" items="{/results}">

                <ObjectListItem
                    title="{CategoryName}"
                    type="Navigation"
                    number="{=${path:'Products/results'}.length}"
                    numberUnit="Products">
                    <ObjectAttribute text="Category ID : {CategoryID}" active="false" />
                    <ObjectAttribute text="{Description}" active="false" />
                </ObjectListItem>

            </List>
        </Panel>
        </f:content>
    </f:DynamicPage>
</mvc:View>