<mvc:View xmlns:home="sap.cux.home"
    xmlns:l="sap.ui.layout" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards"
    xmlns="sap.m"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:core="sap.ui.core"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz="sap.viz.ui5.controls"
    controllerName="bd.businessportal.controller.Dashboard" 
    >

    <f:DynamicPage  id="dashboard_page" class="sapUiResponsiveMargin--content sapUiResponsivePadding--content" headerExpanded="true" >
        <f:title>
            <f:DynamicPageTitle backgroundDesign="Transparent"  > 
                <f:heading>
                            <Toolbar style="Clear">
                                    <Button icon="sap-icon://nav-back" accessibleRole="Link" ariaDescribedBy="back button" press=".navButtonPressed"/>
                                    <Title class="sapUiNoMarginBegin" text="Dashboard" wrapping="false" titleStyle="H5" />
                            </Toolbar>
                        </f:heading>
                        <f:snappedHeading>
                            <Toolbar style="Clear">
                                    <Button icon="sap-icon://nav-back" accessibleRole="Link" ariaDescribedBy="back button" press=".navButtonPressed"/>
                                    <Title class="sapUiNoMarginBegin" text="Dashboard" wrapping="false" titleStyle="H5" />
                            </Toolbar>
                        </f:snappedHeading>

                        <f:snappedContent>
                            <Label  class="sapUiMediumMarginBegin" text="Business Overview" wrappingType="Normal" displayOnly="true" wrapping="true" /> 
                        </f:snappedContent>

                        <f:expandedContent>
                            <Label  class="sapUiMediumMarginBegin" text="Business Overview" wrappingType="Normal" displayOnly="true" wrapping="true" /> 
                        </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader>
                <!-- arrange the tiles -->
                  <ScrollContainer horizontal="true" vertical="false" height="auto" width="100%"  class="" >
                 <HBox gap="0.8rem" class="sapUiSmallMarginBottom" binding="{Mkpi>/ProductStat}"> 
                    <!-- 1 -->
                   	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop noHoverTile" header="{Mkpi>0/Title}"
				 frameType = "OneByHalf" subheader="{Mkpi>0/Description}" press="" pressEnabled="false" >
		        <TileContent unit="count" footer="">
			    <NumericContent truncateValueTo="10"  scale="{Mkpi>0/Unit}" value="{Mkpi>0/Data}" valueColor="Good" withMargin="false" />
		        </TileContent>
	                </GenericTile>
                    <!-- 2 -->
                   	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop noHoverTile" header="{Mkpi>1/Title}"
				 frameType = "OneByHalf" subheader="{Mkpi>1/Description}" press="" pressEnabled="false">
		        <TileContent unit="EUR" footer="">
			    <NumericContent truncateValueTo="10" scale="{Mkpi>1/Unit}" value="{Mkpi>1/Data}" indicator="Up" valueColor="Good" withMargin="false" />
		        </TileContent>
	                </GenericTile>
                    <!-- 3 -->
                   	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop noHoverTile" header="{Mkpi>2/Title}"
				 frameType = "OneByHalf" subheader="{Mkpi>2/Description}" press="" pressEnabled="false" >
		        <TileContent unit="Percentage" footer="">
			    <NumericContent scale="{Mkpi>2/Unit}"  value="{Mkpi>2/Data}" valueColor="None" withMargin="false" />
		        </TileContent>
            </GenericTile>
                    <!-- 4 -->
                   	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop noHoverTile" header="{Mkpi>3/Title}"
				 frameType = "OneByHalf" subheader="{Mkpi>3/Description}" press="" pressEnabled="false" >
		        <TileContent unit="EUR" footer="">
			    <NumericContent truncateValueTo="10" scale="{Mkpi>3/Unit}" value="{Mkpi>3/Data}" valueColor="Neutral" withMargin="false" />
		        </TileContent>
	                </GenericTile>

                </HBox>

                  </ScrollContainer>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
             <l:Grid id="main_grid" hSpacing="1" vSpacing="1"
                class="sapUiSmallMarginTopBottom sapUiNoContentPadding gridPadding-remove"
       >
                            <!-- card-1 -->
                <!-- <f:Card height="400px"  id="product_manage">
                    <f:layoutData>
                                <l:GridData span="XL3 L4 M5 S12"/>
                    
                    </f:layoutData>
                        <f:header>
                            <cards:Header title="Statistics" subtitle="Stat of products,orders and sales | LIQUIDITY">
                            </cards:Header>
