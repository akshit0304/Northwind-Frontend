                    </f:Card> -->
                <!-- card-2 -->
                         <f:Card class="asset sapUiNoMargin" height="400px" >
                                <f:layoutData>
                                            <l:GridData span="XL4 L4 M6 S12"/>
                                
                                </f:layoutData>
                                    <f:header>
                                        <cards:Header title="Company Stats" subtitle="Statistics of Employees, Officials ,Customers">
                                        </cards:Header>
                                    </f:header>
                                    <f:content>
                                        <ScrollContainer horizontal="false" vertical="true" height="auto" width="100%" >
                                            <List  showSeparators="None" width="auto"  class="sapUiTinyMarginEnd" items="{Mkpi>/CompanyStat}">
                                                <items>
                                                <CustomListItem navigated="false" type="Inactive" class="sapUiTinyMarginBottom">
                                                    <HBox alignItems="Start" justifyContent="SpaceBetween" width="auto" class="sapUiTinyMargin">
                                                        <VBox class="sapUiTinyMarginBegin">
                                                            <layoutData>
                                                                <FlexItemData baseSize="60%" growFactor="1" ></FlexItemData>
                                                            </layoutData>
                                                            <Text wrapping="false" text="{Mkpi>Title}" />
                                                            <Label text="{Mkpi>Description}" displayOnly="true" wrapping="true" />
                                                        </VBox>
                                                        <VBox alignItems="End" class="" width="20%">
                                                        <layoutData>
                                                            <FlexItemData alignSelf="Center"/>
                                                        </layoutData>
                                                        <ObjectNumber class="" number="{Mkpi>Data}" state="Success"/>
                                                         <Text text="{Mkpi>Unit}" class="fontsize-S" />
                                                        </VBox>
                                                    </HBox>
                                                </CustomListItem>
                                               
                                                </items>
                                            </List>
                                        </ScrollContainer>
                                    </f:content>
                                </f:Card>
                     <!-- card-3 -->
        <f:Card  id="charts" width="100%" height="400px">
 
					  <f:layoutData>
                                <l:GridData span="XL4 L4 M6 S12"/>
                    </f:layoutData>
            <f:header>
                <cards:Header  title="Top 5 Customers" subtitle="Top 5 customers by order value | EUR">
                </cards:Header>
            </f:header>
            <f:content>
                <viz:VizFrame
                    id="donutChart"
                    width="100%"
                    height="auto"
                    uiConfig="{applicationSet:'fiori'}"
                    vizType="donut"
                    >
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                        data="{Mkpi>/TopCustomers}" >
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                            axis="1"
                            name="Customer"
                            value="{Name}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                            name="OrderAmount"
                            value="{subTotal}" />

                         <viz.data:MeasureDefinition
                            name="Customer ID"
                            value="{Id}" />
                        </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                        uid="size"
                        type="Measure"
                        values="OrderAmount" />
                        <viz.feeds:FeedItem
                        uid="color"
                        type="Dimension"
                        values="Customer" />
                    </viz:feeds>
                    
                </viz:VizFrame>
            </f:content>
        </f:Card>


        <!-- card-4 -->
          <f:Card  id="shipper_chart" width="100%" height="400px">
 
					  <f:layoutData>
                                <l:GridData span="XL4 L4 M6 S12" />
                    </f:layoutData>
            <f:header>
                <cards:Header  title="Shipper Orders Chart" subtitle="Total Delivery Orders by Shippers">
                </cards:Header>
            </f:header>
            <f:content>
                <viz:VizFrame
                    id="shipper_column_chart"
                    width="100%"
                    height="auto"
                    uiConfig="{applicationSet:'fiori'}"
                    vizType="column"
                    >
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                        data="{path:'Mkpi>/ShipperKPI'}" >
                        


                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                            name="Shipper Name"
                            displayValue="Shipper Name"
                            value="{Mkpi>CompanyName}" />
                        </viz.data:dimensions>


                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                            name="Order Managed"
                            value="{Mkpi>SettledOrders}" />
                              <!-- <viz.data:MeasureDefinition
                            name="Color"
                            value="{Mkpi>color}" /> -->
                        </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                        uid="categoryAxis"
                        type="Dimension"
                        values="Shipper Name" />
                        <!-- <viz.feeds:FeedItem uid="color" type="Measure" values="Color"/> -->
                        <viz.feeds:FeedItem
                        uid="valueAxis"
                        type="Measure"
                        values="Order Managed" />

                         <!-- <viz.feeds:FeedItem
                        uid="color"
                        type="Measure"
                        values="Order Fullfillment" /> -->
                    </viz:feeds>
                </viz:VizFrame>
            </f:content>
        </f:Card>
       </l:Grid>
        </f:content>
    </f:DynamicPage>


</mvc:View>